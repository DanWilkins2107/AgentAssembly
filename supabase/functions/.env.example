# Server-secret — these must never reach the web bundle, the CLI, or a committed
# file. Copy to supabase/functions/.env.

GITHUB_APP_ID=

# PKCS#8 PEM, real line breaks. Convert GitHub's PKCS#1 download with:
#   openssl pkcs8 -topk8 -inform PEM -nocrypt -in <downloaded>.pem -out secrets/envkey.pem
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...paste key body here...
-----END PRIVATE KEY-----"
