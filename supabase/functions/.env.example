# === Server-secret tier === (see docs/secrets.md)
# Secrets for the github-token Edge Function (agent PR identity).
# These MUST NEVER reach a browser or be committed. Copy this file to `.env`
# (gitignored) in this directory and fill in the values.
#
#   Local dev:  supabase functions serve github-token --env-file supabase/functions/.env
#   Hosted:     cd supabase && supabase secrets set --env-file functions/.env
#
# PLATFORM-INJECTED — do NOT put these here and never paste/commit them:
#   SUPABASE_SERVICE_ROLE_KEY  (used by github-sync; bypasses RLS — high sensitivity)
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
# All three are injected automatically by `functions serve` and on hosted
# Supabase. The github-sync function needs NO repo-side secret file — its only
# secret is the platform-injected service-role key.

# The GitHub App's numeric App ID (shown on the App's settings page).
GITHUB_APP_ID=

# The GitHub App private key, in PKCS#8 PEM (must start with BEGIN PRIVATE KEY).
# GitHub hands out a PKCS#1 key ("BEGIN RSA PRIVATE KEY"); convert it and save
# the result as secrets/envkey.pem (gitignored — see secrets/README.md):
#   openssl pkcs8 -topk8 -inform PEM -nocrypt -in <downloaded>.pem -out secrets/envkey.pem
# Then paste the contents of secrets/envkey.pem below, with REAL line breaks
# (not \n), wrapped in double quotes:
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...paste key body here...
-----END PRIVATE KEY-----"
