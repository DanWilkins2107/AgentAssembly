# Server-secret tier — see docs/secrets.md. Copy to supabase/functions/.env.
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_URL / SUPABASE_ANON_KEY are platform-injected —
# never add them here. github-sync needs no repo-side secret file.

GITHUB_APP_ID=

# PKCS#8 PEM, real line breaks. Convert GitHub's PKCS#1 download with:
#   openssl pkcs8 -topk8 -inform PEM -nocrypt -in <downloaded>.pem -out secrets/envkey.pem
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...paste key body here...
-----END PRIVATE KEY-----"
