[Unit]
Description=AgentAssembly supervisor loop (powers off on exit)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=loop
Group=loop
WorkingDirectory=/opt/agentassembly/supervisor
# Written at boot by user-data.sh in this directory, which also installs this unit.
EnvironmentFile=/etc/agentassembly/loop.env
ExecStart=/usr/bin/env npm start
# A drain runs for hours; 1d is a stale-run backstop, not an expected duration.
TimeoutStartSec=1d
# The launch template terminates on instance-initiated shutdown and deletes the root
# volume, so this destroys the box — there is no inspection window for a failed run.
# "+": run as root regardless of User=. polkit refuses a poweroff from an
# unprivileged unit, and without it the box never self-terminates.
ExecStopPost=+/usr/bin/systemctl poweroff

[Install]
WantedBy=multi-user.target
